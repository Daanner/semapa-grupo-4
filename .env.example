# ─── Plantilla de configuración ─────────────────────────────────────
# Copia este archivo como ".env" y rellena tus valores.
# El archivo .env NUNCA se sube a git (está en .gitignore).

# ── Correo (Gmail SMTP - gratis) ──
# Necesitas una "contraseña de aplicación" de Google:
#   1. Activa verificación en 2 pasos: https://myaccount.google.com/signinoptions/two-step-verification
#   2. Genera la contraseña: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_contrasena_de_aplicacion_16_chars
MAIL_FROM_NAME=SEMAPA
